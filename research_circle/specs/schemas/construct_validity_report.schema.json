{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/construct_validity_report.schema.json",
  "title": "ConstructValidityReport",
  "type": "object",
  "required": [
    "core_thesis",
    "main_experiment_tests_thesis",
    "metrics_support_claims",
    "benchmark_not_toy",
    "baseline_is_strong_enough",
    "failure_modes_are_diagnostic",
    "ablations_are_diagnostic",
    "negative_result_still_useful",
    "construct_validity_risks",
    "required_plan_revisions"
  ],
  "properties": {
    "core_thesis": { "type": "string", "minLength": 1 },
    "main_experiment_tests_thesis": { "type": "boolean" },
    "metrics_support_claims": { "type": "boolean" },
    "benchmark_not_toy": { "type": "boolean" },
    "baseline_is_strong_enough": { "type": "boolean" },
    "failure_modes_are_diagnostic": { "type": "boolean" },
    "ablations_are_diagnostic": { "type": "boolean" },
    "negative_result_still_useful": { "type": "boolean" },
    "construct_validity_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_plan_revisions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}

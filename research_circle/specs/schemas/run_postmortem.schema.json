{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/run_postmortem.schema.json",
  "title": "RunPostmortem",
  "type": "object",
  "required": [
    "initial_topic",
    "major_pivots",
    "rejected_ideas",
    "successful_reframing",
    "claim_rewrites",
    "sources_that_changed_judgment",
    "workflow_failures",
    "system_improvement_suggestions"
  ],
  "properties": {
    "initial_topic": { "type": "string", "minLength": 1 },
    "major_pivots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rejected_ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["idea", "reason"],
        "properties": {
          "idea": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "successful_reframing": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claim_rewrites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources_that_changed_judgment": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workflow_failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "system_improvement_suggestions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/taste_scores.schema.json",
  "title": "TasteScores",
  "type": "object",
  "properties": {
    "problem_importance": {"type": "integer", "minimum": 1, "maximum": 5},
    "abstraction_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "novelty_robustness": {"type": "integer", "minimum": 1, "maximum": 5},
    "non_incrementality": {"type": "integer", "minimum": 1, "maximum": 5},
    "external_validity": {"type": "integer", "minimum": 1, "maximum": 5},
    "field_timing": {"type": "integer", "minimum": 1, "maximum": 5},
    "theory_potential": {"type": "integer", "minimum": 1, "maximum": 5},
    "benchmark_construct_validity": {"type": "integer", "minimum": 1, "maximum": 5},
    "representative_work_potential": {"type": "integer", "minimum": 1, "maximum": 5},
    "reviewer_defensibility": {"type": "integer", "minimum": 1, "maximum": 5}
  },
  "required": [
    "problem_importance",
    "abstraction_level",
    "novelty_robustness",
    "non_incrementality",
    "external_validity",
    "field_timing",
    "theory_potential",
    "benchmark_construct_validity",
    "representative_work_potential",
    "reviewer_defensibility"
  ],
  "additionalProperties": true
}

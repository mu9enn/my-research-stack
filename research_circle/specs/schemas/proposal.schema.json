{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/proposal.schema.json",
  "title": "Proposal",
  "type": "object",
  "required": [
    "idea_title",
    "plan_3_days",
    "plan_2_weeks",
    "plan_1_month",
    "resource_budget",
    "milestones",
    "fallbacks"
  ],
  "properties": {
    "idea_title": { "type": "string" },
    "plan_3_days": { "type": "array", "items": { "type": "string" } },
    "plan_2_weeks": { "type": "array", "items": { "type": "string" } },
    "plan_1_month": { "type": "array", "items": { "type": "string" } },
    "resource_budget": {
      "type": "object",
      "properties": {
        "compute_hours": { "type": "number", "minimum": 0 },
        "people": { "type": "number", "minimum": 1 },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "milestones": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fallbacks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}

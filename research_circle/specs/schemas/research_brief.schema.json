{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/research_brief.schema.json",
  "title": "ResearchBrief",
  "type": "object",
  "required": [
    "direction",
    "constraints",
    "resources",
    "target_venues",
    "forbidden_items",
    "language",
    "created_at"
  ],
  "properties": {
    "direction": { "type": "string", "minLength": 5 },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "required": ["compute", "team", "time_budget_weeks"],
      "properties": {
        "compute": { "type": "string" },
        "team": { "type": "string" },
        "time_budget_weeks": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "target_venues": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "forbidden_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "language": {
      "type": "string",
      "enum": ["zh", "en"]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}

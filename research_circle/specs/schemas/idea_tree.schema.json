{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/idea_tree.schema.json",
  "title": "IdeaTree",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "idea_id",
          "parent_id",
          "mutation_type",
          "core_thesis",
          "problem_statement",
          "expected_contribution",
          "what_is_new",
          "what_is_not_new",
          "nearest_collision",
          "taste_score",
          "feasibility_score",
          "kill_reasons",
          "next_mutations"
        ],
        "properties": {
          "idea_id": { "type": "string", "minLength": 1 },
          "parent_id": { "type": "string" },
          "mutation_type": {
            "type": "string",
            "enum": [
              "local_extension",
              "abstraction_lift",
              "cross_domain_transfer",
              "benchmark_first",
              "theory_first",
              "systems_first",
              "evaluation_first"
            ]
          },
          "core_thesis": { "type": "string", "minLength": 1 },
          "problem_statement": { "type": "string", "minLength": 1 },
          "expected_contribution": { "type": "string", "minLength": 1 },
          "what_is_new": { "type": "string", "minLength": 1 },
          "what_is_not_new": { "type": "string", "minLength": 1 },
          "nearest_collision": { "type": "array", "items": { "type": "string" } },
          "taste_score": { "type": "object" },
          "feasibility_score": { "type": "object" },
          "kill_reasons": { "type": "array", "items": { "type": "string" } },
          "next_mutations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

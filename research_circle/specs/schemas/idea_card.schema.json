{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/idea_card.schema.json",
  "title": "IdeaCard",
  "type": "object",
  "required": [
    "title",
    "hypothesis",
    "novelty_source",
    "method_sketch",
    "experiment_sketch",
    "risks",
    "similar_work"
  ],
  "properties": {
    "title": { "type": "string" },
    "hypothesis": { "type": "string" },
    "novelty_source": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "method_sketch": { "type": "string" },
    "experiment_sketch": { "type": "string" },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "similar_work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paper_id", "reason"],
        "properties": {
          "paper_id": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "novelty": { "type": "number", "minimum": 0, "maximum": 100 },
        "feasibility": { "type": "number", "minimum": 0, "maximum": 100 },
        "impact": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

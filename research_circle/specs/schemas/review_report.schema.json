{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/review_report.schema.json",
  "title": "ReviewReport",
  "type": "object",
  "required": ["idea_title", "scores", "objections", "revision_suggestions"],
  "properties": {
    "idea_title": { "type": "string" },
    "scores": {
      "type": "object",
      "required": ["novelty", "feasibility", "impact"],
      "properties": {
        "novelty": { "type": "number", "minimum": 0, "maximum": 100 },
        "feasibility": { "type": "number", "minimum": 0, "maximum": 100 },
        "impact": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "severity", "text"],
        "properties": {
          "reviewer": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "text": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "revision_suggestions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}

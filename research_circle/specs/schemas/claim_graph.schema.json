{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://full-circle.local/schemas/claim_graph.schema.json",
  "title": "ClaimGraph",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_text",
          "claim_type",
          "status",
          "collision_sources",
          "why_collision_matters",
          "safe_rewrite",
          "claims_to_avoid",
          "related_work_positioning"
        ],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "claim_text": { "type": "string", "minLength": 1 },
          "claim_type": {
            "type": "string",
            "enum": ["problem", "method", "benchmark", "theory", "empirical", "system", "metric"]
          },
          "status": {
            "type": "string",
            "enum": ["safe", "weaken", "unsafe", "already_covered", "needs_search"]
          },
          "collision_sources": { "type": "array", "items": { "type": "string" } },
          "why_collision_matters": { "type": "string" },
          "safe_rewrite": { "type": "string" },
          "claims_to_avoid": { "type": "array", "items": { "type": "string" } },
          "related_work_positioning": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

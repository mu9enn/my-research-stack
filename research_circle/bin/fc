#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNS_DIR="$ROOT_DIR/runs"

usage() {
  cat <<USAGE
Full Circle CLI

Usage:
  ./bin/fc init-run --topic <text> [--run-id <id>] [--language zh|en]
  ./bin/fc status --run-id <id>
  ./bin/fc checkpoint --run-id <id> --stage <stage> --decision approved|needs_revision|blocked [--note <text>]
USAGE
}

slugify() {
  local raw="$1"
  local slug
  slug="$(echo "$raw" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/-\{2,\}/-/g' | sed 's/^-\|-$//g')"
  if [[ -z "$slug" ]]; then
    slug="topic"
  fi
  echo "$slug"
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

init_run() {
  local topic=""
  local run_id=""
  local language="zh"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --topic)
        topic="$2"; shift 2 ;;
      --run-id)
        run_id="$2"; shift 2 ;;
      --language)
        language="$2"; shift 2 ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1 ;;
    esac
  done

  if [[ -z "$topic" ]]; then
    echo "--topic is required" >&2
    exit 1
  fi

  if [[ -z "$run_id" ]]; then
    local ts
    ts="$(date +"%Y%m%d-%H%M%S")"
    local slug
    slug="$(slugify "$topic")"
    run_id="${ts}-${slug}"
  fi

  local run_dir="$RUNS_DIR/$run_id"
  mkdir -p "$run_dir/checkpoints" "$run_dir/artifacts" "$run_dir/logs"
  local escaped_topic
  escaped_topic="${topic//\"/\\\"}"

  cat > "$run_dir/run_meta.json" <<JSON
{
  "run_id": "$run_id",
  "topic": "$escaped_topic",
  "language": "$language",
  "mode": "human-in-the-loop",
  "created_at": "$(now_utc)",
  "stage_order": [
    "intake",
    "literature-search",
    "literature-review",
    "gap-mining",
    "idea-generation",
    "novelty-check",
    "proposal-ranking",
    "research-planning"
  ]
}
JSON

  local cp_stage
  for cp_stage in intake literature-review gap-mining idea-generation proposal-ranking research-planning; do
    cat > "$run_dir/checkpoints/$cp_stage.json" <<JSON
{
  "stage": "$cp_stage",
  "decision": "pending",
  "note": "",
  "updated_at": ""
}
JSON
  done

  touch "$run_dir/logs/tool_calls.log"

  echo "Created run: $run_id"
  echo "Path: $run_dir"
}

file_status() {
  local file="$1"
  if [[ -s "$file" ]]; then
    echo "done"
  elif [[ -e "$file" ]]; then
    echo "created"
  else
    echo "missing"
  fi
}

checkpoint_decision() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    echo "n/a"
    return
  fi
  local decision
  decision="$(grep -E '"decision"' "$path" | head -n1 | sed -E 's/.*"decision"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')"
  if [[ -z "$decision" ]]; then
    decision="unknown"
  fi
  echo "$decision"
}

show_status() {
  local run_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run-id)
        run_id="$2"; shift 2 ;;
      *)
        echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done

  if [[ -z "$run_id" ]]; then
    echo "--run-id is required" >&2
    exit 1
  fi

  local run_dir="$RUNS_DIR/$run_id"
  if [[ ! -d "$run_dir" ]]; then
    echo "Run not found: $run_id" >&2
    exit 1
  fi

  echo "Run: $run_id"
  echo "Path: $run_dir"
  echo
  printf "%-20s %-12s %-16s\n" "Stage" "Artifact" "Checkpoint"
  printf "%-20s %-12s %-16s\n" "--------------------" "------------" "----------------"

  printf "%-20s %-12s %-16s\n" "intake" "$(file_status "$run_dir/artifacts/research_brief.json")" "$(checkpoint_decision "$run_dir/checkpoints/intake.json")"
  printf "%-20s %-12s %-16s\n" "literature-search" "$(file_status "$run_dir/artifacts/paper_bank.jsonl")" "n/a"
  printf "%-20s %-12s %-16s\n" "literature-review" "$(file_status "$run_dir/artifacts/literature_map.md")" "$(checkpoint_decision "$run_dir/checkpoints/literature-review.json")"
  printf "%-20s %-12s %-16s\n" "gap-mining" "$(file_status "$run_dir/artifacts/gap_analysis.md")" "$(checkpoint_decision "$run_dir/checkpoints/gap-mining.json")"
  printf "%-20s %-12s %-16s\n" "idea-generation" "$(file_status "$run_dir/artifacts/ideas.json")" "$(checkpoint_decision "$run_dir/checkpoints/idea-generation.json")"
  printf "%-20s %-12s %-16s\n" "novelty-check" "$(file_status "$run_dir/artifacts/novelty_check.md")" "n/a"
  printf "%-20s %-12s %-16s\n" "proposal-ranking" "$(file_status "$run_dir/artifacts/ranked_proposals.md")" "$(checkpoint_decision "$run_dir/checkpoints/proposal-ranking.json")"
  printf "%-20s %-12s %-16s\n" "research-planning" "$(file_status "$run_dir/artifacts/research_plan.md")" "$(checkpoint_decision "$run_dir/checkpoints/research-planning.json")"
}

write_checkpoint() {
  local run_id=""
  local stage=""
  local decision=""
  local note=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run-id)
        run_id="$2"; shift 2 ;;
      --stage)
        stage="$2"; shift 2 ;;
      --decision)
        decision="$2"; shift 2 ;;
      --note)
        note="$2"; shift 2 ;;
      *)
        echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done

  if [[ -z "$run_id" || -z "$stage" || -z "$decision" ]]; then
    echo "--run-id, --stage, --decision are required" >&2
    exit 1
  fi

  case "$decision" in
    approved|needs_revision|blocked) ;;
    *)
      echo "Invalid decision: $decision" >&2
      exit 1 ;;
  esac

  local run_dir="$RUNS_DIR/$run_id"
  local file="$run_dir/checkpoints/$stage.json"
  if [[ ! -d "$run_dir" ]]; then
    echo "Run not found: $run_id" >&2
    exit 1
  fi

  local escaped_note
  escaped_note="${note//\"/\\\"}"

  cat > "$file" <<JSON
{
  "stage": "$stage",
  "decision": "$decision",
  "note": "$escaped_note",
  "updated_at": "$(now_utc)"
}
JSON

  echo "Checkpoint updated: $file"
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    init-run) init_run "$@" ;;
    status) show_status "$@" ;;
    checkpoint) write_checkpoint "$@" ;;
    *)
      usage
      exit 1 ;;
  esac
}

main "$@"
